// ─── Sort Dropdown ────────────────────────────────────────────────────────────
type SortKey = "featured"|"price-asc"|"price-desc"|"newest"|"bestseller";
const SORT_OPTIONS: {value:SortKey; label:string}[] = [
  { value:"featured",    label:"Featured" },
  { value:"newest",      label:"Newest First" },
  { value:"bestseller",  label:"Bestsellers" },
  { value:"price-asc",   label:"Price: Low to High" },
  { value:"price-desc",  label:"Price: High to Low" },
];

function SortSelect({ value, onChange }:{ value:SortKey; onChange:(v:SortKey)=>void }) {
  const [open, setOpen] = useState(false);
  const current = SORT_OPTIONS.find(o=>o.value===value)!;
  return (
    <div className="relative">
      <button onClick={()=>setOpen(v=>!v)}
        className="flex items-center gap-3 text-[10px] tracking-[0.2em] uppercase py-2 px-4 border transition-colors"
        style={{ fontFamily:"Inter,sans-serif", color:T.espresso, borderColor:`${T.muted}25`,
                 backgroundColor:T.ivory }}>
        {current.label}
        <motion.svg animate={{ rotate: open?180:0 }} transition={{ duration:0.2 }}
          width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
          <polyline points="6,9 12,15 18,9"/>
        </motion.svg>
      </button>
      <AnimatePresence>
        {open && (
          <>
            <div className="fixed inset-0 z-10" onClick={()=>setOpen(false)}/>
            <motion.div initial={{ opacity:0,y:-6 }} animate={{ opacity:1,y:0 }} exit={{ opacity:0,y:-6 }}
              transition={{ duration:0.2 }}
              className="absolute right-0 top-full mt-1 z-20 min-w-full border shadow-lg"
              style={{ backgroundColor:T.ivory, borderColor:`${T.muted}20` }}>
              {SORT_OPTIONS.map(o=>(
                <button key={o.value} onClick={()=>{ onChange(o.value); setOpen(false); }}
                  className="w-full text-left px-4 py-2.5 text-[10px] tracking-[0.15em] uppercase transition-colors whitespace-nowrap"
                  style={{ fontFamily:"Inter,sans-serif",
                    color: o.value===value ? T.espresso : T.muted,
                    backgroundColor: o.value===value ? T.dust : "transparent" }}
                  onMouseEnter={e=>(e.currentTarget.style.backgroundColor=T.dust)}
                  onMouseLeave={e=>(e.currentTarget.style.backgroundColor=o.value===value?T.dust:"transparent")}>
                  {o.label}
                </button>
              ))}
            </motion.div>
          </>
        )}
      </AnimatePresence>
    </div>
  );
}

// ─── View Toggle ──────────────────────────────────────────────────────────────
function ViewToggle({ view, onChange }:{ view:"grid"|"editorial"; onChange:(v:"grid"|"editorial")=>void }) {
  return (
    <div className="flex border" style={{ borderColor:`${T.muted}25` }}>
      {(["grid","editorial"] as const).map(v=>(
        <button key={v} onClick={()=>onChange(v)}
          className="px-3 py-2 transition-all duration-200"
          style={{ backgroundColor: view===v ? T.espresso : "transparent" }}
          title={v==="grid"?"Grid view":"Editorial view"}>
          {v==="grid" ? (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={view==="grid"?T.ivory:T.muted} strokeWidth="1.5">
              <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
              <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
            </svg>
          ) : (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={view==="editorial"?T.ivory:T.muted} strokeWidth="1.5">
              <rect x="3" y="3" width="7" height="18"/><rect x="14" y="3" width="7" height="8"/>
              <rect x="14" y="14" width="7" height="7"/>
            </svg>
          )}
        </button>
      ))}
    </div>
  );
}

// ─── Main Page ────────────────────────────────────────────────────────────────
const DEFAULT_FILTERS: Filters = {
  collections: new Set<Collection>(),
  genders:     new Set<Gender>(),
  families:    new Set<ScentFamily>(),
  concentrations: new Set<Concentration>(),
  price:       [100, 700],
  badges:      new Set<string>(),
};

export default function ProductsPage() {
  const [filters, setFilters]   = useState<Filters>(DEFAULT_FILTERS);
  const [search, setSearch]     = useState("");
  const [sort, setSort]         = useState<SortKey>("featured");
  const [view, setView]         = useState<"grid"|"editorial">("grid");
  const [drawerOpen, setDrawer] = useState(false);
  const [cart, setCart]         = useState<Set<number>>(new Set());
  const [wishlist, setWishlist] = useState<Set<number>>(new Set());
  const [searchFocused, setSearchFocused] = useState(false);
  const searchRef = useRef<HTMLInputElement>(null);

  const resetFilters = useCallback(()=>setFilters(DEFAULT_FILTERS),[]);

  // Filter + sort logic
  const filtered = useMemo(()=>{
    let res = PRODUCTS.filter(p=>{
      if (search) {
        const q = search.toLowerCase();
        const match = p.name.toLowerCase().includes(q) ||
          p.family.toLowerCase().includes(q) ||
          p.subtitle.toLowerCase().includes(q) ||
          p.notes.top.some(n=>n.toLowerCase().includes(q)) ||
          p.notes.heart.some(n=>n.toLowerCase().includes(q)) ||
          p.notes.base.some(n=>n.toLowerCase().includes(q));
        if (!match) return false;
      }
      if (filters.collections.size && !filters.collections.has(p.collection)) return false;
      if (filters.genders.size     && !filters.genders.has(p.gender))         return false;
      if (filters.families.size    && !filters.families.has(p.family))         return false;
      if (filters.concentrations.size && !filters.concentrations.has(p.concentration)) return false;
      if (p.price < filters.price[0] || p.price > filters.price[1])            return false;
      if (filters.badges.has("isBestseller") && !p.isBestseller) return false;
      if (filters.badges.has("isNew")        && !p.isNew)        return false;
      if (filters.badges.has("isLimited")    && !p.isLimited)    return false;
      return true;
    });
    res = [...res].sort((a,b)=>{
      if (sort==="price-asc")  return a.price-b.price;
      if (sort==="price-desc") return b.price-a.price;
      if (sort==="newest")     return b.year-a.year;
      if (sort==="bestseller") return (b.isBestseller?1:0)-(a.isBestseller?1:0);
      return 0;
    });
    return res;
  },[filters, search, sort]);

  const activeFilterCount =
    filters.collections.size + filters.genders.size + filters.families.size +
    filters.concentrations.size + filters.badges.size +
    (filters.price[0]>100||filters.price[1]<700 ? 1 : 0);

  const handleCart = (id:number) => {
    setCart(s=>{ const n=new Set(s); n.add(id); return n; });
  };
  const handleWishlist = (id:number) => {
    setWishlist(s=>{ const n=new Set(s); n.has(id)?n.delete(id):n.add(id); return n; });
  };

  return (
    <>
      <FontLoader/>
      <Cursor/>
      <div style={{ backgroundColor:T.ivory, minHeight:"100vh", cursor:"none" }}>
        <Header cartCount={cart.size}/>
        <PageBanner/>

        {/* Breadcrumb */}
        <div className="max-w-screen-xl mx-auto px-5 md:px-10 py-4 flex items-center gap-2">
          {["Home","Parfums","All Fragrances"].map((b,i,arr)=>(
            <span key={b} className="flex items-center gap-2">
              <span className="text-[9px] tracking-[0.15em] uppercase"
                style={{ fontFamily:"Inter,sans-serif",
                  color: i<arr.length-1 ? `${T.muted}70` : T.espresso }}>
                {b}
              </span>
              {i<arr.length-1 && <span style={{ color:`${T.muted}40`, fontSize:"10px" }}>/</span>}
            </span>
          ))}
        </div>

        <div className="max-w-screen-xl mx-auto px-5 md:px-10 pb-24">
          {/* Search + toolbar */}
          <div className="mb-6">
            <div className="relative">
              <motion.div
                animate={{ borderColor: searchFocused ? T.gold : `${T.muted}25` }}
                transition={{ duration:0.2 }}
                className="flex items-center gap-3 border px-4 py-3"
                style={{ backgroundColor:T.ivory }}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={searchFocused?T.gold:T.muted} strokeWidth="1.5"
                  className="flex-shrink-0 transition-colors duration-200">
                  <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <input ref={searchRef} type="text" value={search} onChange={e=>setSearch(e.target.value)}
                  onFocus={()=>setSearchFocused(true)}
                  onBlur={()=>setSearchFocused(false)}
                  placeholder="Search by name, note, or family…"
                  className="flex-1 outline-none bg-transparent text-sm"
                  style={{ fontFamily:"Inter,sans-serif", color:T.espresso, fontWeight:300 }}/>
                <AnimatePresence>
                  {search && (
                    <motion.button initial={{ opacity:0 }} animate={{ opacity:1 }} exit={{ opacity:0 }}
                      onClick={()=>setSearch("")} style={{ color:T.muted }}
                      className="transition-colors hover:text-espresso">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                      </svg>
                    </motion.button>
                  )}
                </AnimatePresence>
              </motion.div>
            </div>

            {/* Toolbar row */}
            <div className="flex items-center justify-between mt-3 flex-wrap gap-3">
              <div className="flex items-center gap-3">
                {/* Mobile filter toggle */}
                <button onClick={()=>setDrawer(true)}
                  className="md:hidden flex items-center gap-2 text-[9px] tracking-[0.2em] uppercase px-3.5 py-2 border relative"
                  style={{ fontFamily:"Inter,sans-serif", color:T.espresso, borderColor:`${T.muted}25` }}>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
                    <line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/>
                  </svg>
                  Filters
                  {activeFilterCount>0 && (
                    <span className="w-4 h-4 rounded-full text-[8px] flex items-center justify-center"
                      style={{ backgroundColor:T.gold, color:T.espresso }}>
                      {activeFilterCount}
                    </span>
                  )}
                </button>
                <motion.span key={filtered.length} initial={{ opacity:0 }} animate={{ opacity:1 }}
                  className="text-[10px]" style={{ fontFamily:"Cormorant Garamond,serif", color:T.muted, fontStyle:"italic" }}>
                  {filtered.length} {filtered.length===1?"fragrance":"fragrances"}
                </motion.span>
              </div>
              <div className="flex items-center gap-3">
                <SortSelect value={sort} onChange={setSort}/>
                <ViewToggle view={view} onChange={setView}/>
              </div>
            </div>

            {/* Active filter chips */}
            <AnimatePresence>
              {activeFilterCount>0 && <ActiveChips filters={filters} onChange={setFilters}/>}
            </AnimatePresence>
          </div>

          {/* Body: sidebar + grid */}
          <div className="flex gap-8 lg:gap-12 items-start">

            {/* Sidebar (desktop) */}
            <aside className="hidden md:block flex-shrink-0 w-52 lg:w-60 sticky top-24">
              <FilterPanel filters={filters} onChange={setFilters} onReset={resetFilters} count={filtered.length}/>
            </aside>

            {/* Product Grid */}
            <main className="flex-1 min-w-0">
              <AnimatePresence mode="wait">
                {filtered.length===0 ? (
                  <EmptyState key="empty" onReset={resetFilters}/>
                ) : view==="grid" ? (
                  <motion.div key="grid"
                    className="grid grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-10">
                    <AnimatePresence>
                      {filtered.map((p,i)=>(
                        <motion.div key={p.id} layout
                          initial={{ opacity:0, y:20 }} animate={{ opacity:1, y:0 }}
                          exit={{ opacity:0, scale:0.96 }}
                          transition={{ duration:0.4, delay:i*0.04, ease:[0.22,1,0.36,1] }}>
                          <ProductCard product={p} view="grid"
                            onAddToCart={handleCart} onWishlist={handleWishlist}
                            wishlisted={wishlist.has(p.id)}/>
                        </motion.div>
                      ))}
                    </AnimatePresence>
                  </motion.div>
                ) : (
                  <motion.div key="editorial" className="flex flex-col">
                    <AnimatePresence>
                      {filtered.map((p,i)=>(
                        <motion.div key={p.id} layout
                          initial={{ opacity:0, y:20 }} animate={{ opacity:1, y:0 }}
                          exit={{ opacity:0 }}
                          transition={{ duration:0.4, delay:i*0.04, ease:[0.22,1,0.36,1] }}>
                          <ProductCard product={p} view="editorial"
                            onAddToCart={handleCart} onWishlist={handleWishlist}
                            wishlisted={wishlist.has(p.id)}/>
                        </motion.div>
                      ))}
                    </AnimatePresence>
                  </motion.div>
                )}
              </AnimatePresence>
            </main>
          </div>
        </div>

        {/* Mobile drawer */}
        <MobileFilterDrawer open={drawerOpen} onClose={()=>setDrawer(false)}
          filters={filters} onChange={setFilters} onReset={resetFilters} count={filtered.length}/>

        {/* Minimal footer strip */}
        <div className="border-t py-8 px-5 md:px-10 flex flex-col md:flex-row items-center justify-between gap-3"
          style={{ borderColor:`${T.gold}15`, backgroundColor:"#100D0B" }}>
          <span className="text-[9px] tracking-[0.3em] uppercase"
            style={{ fontFamily:"Inter,sans-serif", color:`${T.ivory}25` }}>
            © 2026 Maison Éclore Paris
          </span>
          <div className="flex gap-6">
            {["Privacy","Terms","Shipping"].map(l=>(
              <a key={l} href="#" className="text-[9px] tracking-[0.15em] uppercase transition-colors"
                style={{ fontFamily:"Inter,sans-serif", color:`${T.ivory}25` }}
                onMouseEnter={e=>(e.currentTarget.style.color=`${T.ivory}55`)}
                onMouseLeave={e=>(e.currentTarget.style.color=`${T.ivory}25`)}>
                {l}
              </a>
            ))}
          </div>
        </div>
      </div>
    </>
  );
}